{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": false,
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeMinor",
    ":automergePatch",
    "schedule:weekly",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "configMigration": true,
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "prConcurrentLimit": 5,
  "timezone": "Europe/Paris",
  "packageRules": [
    {
      "description": "Écosystème Tailwind CSS",
      "groupName": "Tailwind CSS",
      "matchPackageNames": ["/^@tailwindcss//", "/^tailwindcss$/"]
    },
    {
      "description": "Outils de lint et de formatage",
      "groupName": "Lint et formatage",
      "matchPackageNames": ["/^eslint/", "/^@commitlint//", "/prettier/", "lint-staged", "husky"]
    },
    {
      "description": "Ne jamais auto-merger un bump mineur sur un paquet 0.x (un minor peut être cassant en semver 0.x)",
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": "0",
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  }
}
