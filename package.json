{
  "name": "portfolio",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "serve": "wrangler dev --port 8787 --ip 127.0.0.1",
    "test": "playwright test --project=chromium",
    "verify": "pnpm format:check && pnpm lint && pnpm knip && pnpm check && pnpm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "simple-icons": "16.38.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-playwright": "2.12.2",
    "husky": "9.1.7",
    "knip": "6.48.0",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "wrangler": "4.168.0"
  },
  "lint-staged": {
    "*.{astro,ts,js}": [
      "eslint --fix"
    ],
    "*": "prettier --write --ignore-unknown --log-level warn"
  },
  "packageManager": "pnpm@12.23.0"
}
