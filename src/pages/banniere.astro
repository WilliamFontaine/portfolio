---
import { getEntries } from 'astro:content'
import Icon from '@/components/ui/Icon.astro'
import Monogram from '@/components/brand/Monogram.astro'
import Skyline from '@/components/brand/Skyline.astro'
import Base from '@/layouts/Base.astro'

const logos = await getEntries(
  [
    'java',
    'spring-boot',
    'angular',
    'react',
    'nextjs',
    'nuxt',
    'typescript',
    'postgresql',
    'docker',
  ].map((id) => ({ collection: 'stack', id })),
)
---

<Base
  title="Bannière LinkedIn · William Fontaine"
  description="Bannière LinkedIn et image de partage de wfontaine.fr, à exporter."
  noindex
>
  <main class="flex flex-col items-start gap-10 p-10">
    <section
      aria-label="Bannière LinkedIn"
      class="relative h-99 w-396 shrink-0 overflow-hidden bg-surface scheme-light"
    >
      <div class="absolute inset-x-0 bottom-0">
        <Skyline variant="fill" id="banner" class="h-47.5" />
      </div>
      <div class="absolute top-12 right-24 flex flex-col items-end gap-4.5 text-right">
        <h1 class="text-display-sm">
          Du besoin à la mise en production.
          <br />
          <span class="text-accent">Et&nbsp;après.</span>
        </h1>
        <p class="flex items-center gap-2.5 font-display text-h4 text-text">
          <Monogram size={28} />
          wfontaine.fr
        </p>
        <div class="flex items-center gap-5.5 text-text-muted">
          {logos.map(({ data }) => (
            <Icon set="simple" name={data.icon} size={26} />
          ))}
        </div>
      </div>
    </section>
    <section
      aria-label="Image de partage"
      class="relative h-157.5 w-300 shrink-0 overflow-hidden bg-surface scheme-light"
    >
      <div class="absolute inset-x-0 bottom-0">
        <Skyline variant="fill" id="share" class="h-62.5" />
      </div>
      <div class="absolute inset-x-0 top-16 flex flex-col items-center gap-7 text-center">
        <p class="font-display text-display text-ink">
          Du besoin à la mise
          <br />
          en production.
          <br />
          <span class="text-accent">Et&nbsp;après.</span>
        </p>
        <p class="flex items-center gap-3 font-display text-link-lg text-text">
          <Monogram size={36} />
          wfontaine.fr
        </p>
      </div>
    </section>
  </main>
</Base>
