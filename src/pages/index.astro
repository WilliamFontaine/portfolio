---
import { getCollection } from 'astro:content'
import About from '../components/About.astro'
import ActionLink from '../components/ActionLink.astro'
import CaseStudy from '../components/CaseStudy.astro'
import Contact from '../components/Contact.astro'
import Container from '../components/Container.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import SectionHeading from '../components/SectionHeading.astro'
import SideProjects from '../components/SideProjects.astro'
import Skills from '../components/Skills.astro'
import Base from '../layouts/Base.astro'

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order)
---

<Base
  title="William Fontaine, développeur full-stack à Clermont-Ferrand"
  description="Je conçois et développe des logiciels métier, web et mobile, du besoin à la mise en production, puis j'en assure le suivi. Basé à Clermont-Ferrand."
>
  <Header home />
  <main>
    <Hero />
    <section id="realisations" class="pt-14 pb-6 md:pt-28 md:pb-10">
      <Container class="flex flex-col gap-10 md:gap-24">
        <div class="flex flex-col gap-3">
          <SectionHeading label="Réalisations" title="Des logiciels en production" />
        </div>
        {cases.map((entry, index) => (
          <CaseStudy {entry} reverse={index % 2 === 1} />
        ))}
        <div class="flex flex-wrap items-center justify-between gap-2 border-y border-line py-5 md:gap-6 md:py-6">
          <p class="font-display text-h3-compact text-ink md:text-h3">
            Un logiciel métier à construire&#x202F;?
          </p>
          <ActionLink href="#contact">Parlons de votre projet</ActionLink>
        </div>
        <SideProjects />
      </Container>
    </section>
    <Skills />
    <About />
    <Contact />
  </main>
  <Footer />
</Base>
