---
import panorama from './panorama-180.json'
import Ridge from './Ridge.astro'

type Props = { class?: string } & ({ variant: 'fill'; id: string } | { variant: 'stroke' })

const props = Astro.props
const className = props.class
const { W, H, d, tower: towerMarkup } = panorama
const viewBox = `0 0 ${W} ${H}`

// The flow's soft front: fainter copies stacked above the shape, since WebKit drops a blur filter past 4096 device px.
const steps = 32
const span = 80
const ease = (t: number) => t * t * (3 - 2 * t)
const through = (k: number) => ease(Math.min(1, (k - 0.5) / steps))
// Copy k darkens the bands it covers so that the light let through follows the eased ramp.
const front = Array.from({ length: steps }, (_, i) => ({
  y: -90 - ((i + 1) * span) / steps,
  opacity: (1 - through(i + 1) / through(i + 2)).toFixed(3),
}))
---

{props.variant === 'fill' ? (
  <div data-arrival class:list={['relative', className]}>
    <svg
      data-sky
      class="absolute inset-0 size-full overflow-visible motion-safe:animate-draw-compact md:motion-safe:animate-draw"
      viewBox={viewBox}
      preserveAspectRatio="xMidYMin slice"
      aria-hidden="true"
    >
      <defs>
        <path id={`area-${props.id}`} d={`${d} L${W},${H} L0,${H} Z`} />
        <linearGradient id={`gradient-${props.id}`} x1="0" x2="0" y1="0" y2="1">
          <stop offset=".12" class="text-sky-top" stop-color="currentColor" />
          <stop offset=".8" class="text-sky-end" stop-color="currentColor" />
          <stop offset="1" class="text-sky-end" stop-color="currentColor" stop-opacity="0" />
        </linearGradient>
        <mask id={`flow-${props.id}`} maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
          <rect width={W} height={H} fill="#fff" />
          <g
            transform="translate(0 520)"
            class="motion-safe:animate-flow-compact md:motion-safe:animate-flow"
          >
            {front.map(({ y, opacity }) => (
              <use href={`#area-${props.id}`} {y} fill-opacity={opacity} />
            ))}
            <use href={`#area-${props.id}`} y="-90" />
            <rect y="200" width={W} height="450" />
          </g>
        </mask>
      </defs>
      <use
        href={`#area-${props.id}`}
        fill={`url(#gradient-${props.id})`}
        mask={`url(#flow-${props.id})`}
      />
    </svg>
    <svg
      data-sky
      class="absolute inset-0 size-full overflow-visible text-sky-top motion-safe:animate-draw-compact md:motion-safe:animate-draw"
      viewBox={viewBox}
      preserveAspectRatio="xMidYMin slice"
      aria-hidden="true"
    >
      <Ridge />
      <g
        data-sky-tower
        fill="currentColor"
        class="origin-bottom transform-fill motion-safe:animate-rise-compact md:motion-safe:animate-rise"
        set:html={towerMarkup}
      />
    </svg>
  </div>
) : (
  <svg
    data-sky
    class:list={['block w-full text-structure', className]}
    viewBox={viewBox}
    preserveAspectRatio="xMidYMin slice"
    aria-hidden="true"
  >
    <Ridge />
  </svg>
)}

<script>
  const motion = matchMedia('(prefers-reduced-motion: no-preference)')
  // WebKit may not have created the arrival's animations when this runs: pause them on the first frame.
  requestAnimationFrame(() => {
    if (!motion.matches) return
    // On a phone the arrival waits until half the line shows above the reading line (ReadingLine.astro).
    const band = document.querySelector<HTMLElement>('[data-reading]')?.offsetHeight ?? 0
    for (const sky of document.querySelectorAll('[data-arrival]')) {
      for (const animation of sky.getAnimations({ subtree: true })) animation.pause()
      const wait = new IntersectionObserver(
        ([entry]) => {
          if (entry!.intersectionRatio < 0.5) return
          wait.disconnect()
          // Live animations only: a switch of the motion preference meanwhile replaces them.
          if (motion.matches)
            for (const animation of sky.getAnimations({ subtree: true })) animation.play()
        },
        { threshold: 0.5, rootMargin: `0px 0px -${band}px 0px` },
      )
      wait.observe(sky)
    }
  })
</script>
