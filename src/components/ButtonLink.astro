---
interface Props {
  href: string
  class?: string
  compact?: boolean
}

const { href, class: className, compact } = Astro.props
---

<a
  {href}
  class:list={[
    'inline-flex min-h-11 items-center rounded-pill bg-brand text-on-brand hover:bg-accent',
    compact ? 'px-4 text-ui-compact' : 'px-5 text-ui',
    className,
  ]}
>
  <slot />
</a>
