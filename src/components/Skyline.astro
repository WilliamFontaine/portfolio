---
import panorama from '../data/panorama-180.json'

type Props = { class?: string } & ({ variant: 'fill'; id: string } | { variant: 'stroke' })

const props = Astro.props
const className = props.class
const { W, H, d, tower: towerMarkup } = panorama
const viewBox = `0 0 ${W} ${H}`
---

{props.variant === 'fill' ? (
  <div class:list={['relative', className]}>
    <svg
      data-sky
      class="absolute inset-0 size-full overflow-visible"
      viewBox={viewBox}
      preserveAspectRatio="xMidYMin slice"
      aria-hidden="true"
    >
      <defs>
        <path id={`area-${props.id}`} d={`${d} L${W},${H} L0,${H} Z`} />
        <linearGradient id={`gradient-${props.id}`} x1="0" x2="0" y1="0" y2="1">
          <stop offset=".12" class="text-sky-top" stop-color="currentColor" />
          <stop offset=".8" class="text-sky-end" stop-color="currentColor" />
          <stop offset="1" class="text-sky-end" stop-color="currentColor" stop-opacity="0" />
        </linearGradient>
        <mask id={`flow-${props.id}`} maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
          <rect width={W} height={H} fill="#fff" />
          <g transform="translate(0 520)">
            <g filter={`url(#soft-${props.id})`}>
              <use href={`#area-${props.id}`} y="-90" />
              <rect y="200" width={W} height="450" />
            </g>
          </g>
        </mask>
        <filter id={`soft-${props.id}`} x="0" y="-40%" width="100%" height="180%">
          <feGaussianBlur stdDeviation="0 30" />
        </filter>
      </defs>
      <use
        href={`#area-${props.id}`}
        fill={`url(#gradient-${props.id})`}
        mask={`url(#flow-${props.id})`}
      />
    </svg>
    <svg
      data-sky
      class="absolute inset-0 size-full overflow-visible text-sky-top"
      viewBox={viewBox}
      preserveAspectRatio="xMidYMin slice"
      aria-hidden="true"
    >
      <path
        {d}
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        vector-effect="non-scaling-stroke"
      />
      <g data-sky-tower fill="currentColor" set:html={towerMarkup} />
    </svg>
  </div>
) : (
  <svg
    data-sky
    class:list={['block w-full text-structure', className]}
    viewBox={viewBox}
    preserveAspectRatio="xMidYMin slice"
    aria-hidden="true"
  >
    <path
      {d}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      vector-effect="non-scaling-stroke"
    />
  </svg>
)}
