---
import { phosphor, simple } from '../data/icons'

type Props = (
  { set: 'phosphor'; name: keyof typeof phosphor } | { set: 'simple'; name: keyof typeof simple }
) & { size: number; class?: string }

const props = Astro.props
const { size, class: className } = props
const Svg = props.set === 'phosphor' ? phosphor[props.name] : simple[props.name]
---

<Svg
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  class:list={['shrink-0', className]}
/>
