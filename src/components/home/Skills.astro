---
import { getEntries } from 'astro:content'
import Card from '@/components/ui/Card.astro'
import Container from '@/components/ui/Container.astro'
import Icon from '@/components/ui/Icon.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import { reveal } from '@/scripts/reveal'

const technologies = (ids: string[]) => getEntries(ids.map((id) => ({ collection: 'stack', id })))
const ecosystems = await Promise.all(
  [
    {
      ids: ['java', 'spring-boot', 'angular'],
      where: 'Chez TerrAgree et NEO-FUGU, et sur mes produits',
    },
    { ids: ['react', 'nextjs'], where: 'Chez NEOGO' },
    { ids: ['vue', 'nuxt'], where: 'Sur Quoi Regarder, Egenr et ComWave' },
  ].map(async ({ ids, where }) => ({ stack: await technologies(ids), where })),
)
const operations = await technologies(['docker', 'github-actions'])
---

<section id="competences" class="mt-8 bg-structure-soft py-14 md:mt-18 md:py-24">
  <Container class="flex flex-col gap-7 md:gap-10">
    <div data-reveal class:list={['flex flex-col gap-3', reveal]}>
      <SectionHeading label="Compétences" title="Trois écosystèmes en production" />
      <p>Uniquement ce que j'ai mis en production, chez des clients ou sur mes propres produits.</p>
    </div>
    <div class="flex flex-col gap-4">
      <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {ecosystems.map(({ stack, where }) => (
          <Card as="li" class="flex flex-col gap-2.5 md:max-lg:last:col-span-2">
            <div class="mb-2 flex gap-3.5 text-structure">
              {stack.map(({ data }) => (
                <Icon set="simple" name={data.icon} size={28} />
              ))}
            </div>
            <h3 class="text-h4-compact md:text-h4">
              {stack.map(({ data }) => data.label).join(' · ')}
            </h3>
            <p class="text-small text-text-muted">{where}</p>
          </Card>
        ))}
      </ul>
      <div
        data-reveal
        class:list={[
          'flex flex-wrap items-center gap-3.5 rounded-md border border-dashed border-line-strong px-5.5 py-5 md:gap-6 md:px-7',
          reveal,
        ]}
      >
        <div class="flex gap-3.5 text-structure">
          {operations.map(({ data }) => (
            <Icon set="simple" name={data.icon} size={26} />
          ))}
        </div>
        <div class="flex grow basis-65 flex-col gap-0.5">
          <h3 class="text-h4-compact">Et ce qui les fait tourner</h3>
          <p class="text-small text-text-muted">
            Docker, intégration continue, mise en production et suivi, chez TerrAgree et NSE.
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
