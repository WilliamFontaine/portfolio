---
import type { HTMLTag } from 'astro/types'
import { revealInRow } from './reveal'

interface Props {
  as?: HTMLTag
  class?: string
}

const { as: Tag = 'div', class: className } = Astro.props
---

<Tag
  data-reveal
  class:list={[
    'rounded-md border border-line bg-surface-raised p-5.5 md:p-7',
    revealInRow,
    className,
  ]}
>
  <slot />
</Tag>
